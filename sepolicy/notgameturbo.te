allow platform_app hal_touchfeature_xiaomi_service:service_manager find;
binder_call(platform_app, hal_touchfeature_xiaomi_default)
allow priv_app hal_touchfeature_xiaomi_service:service_manager find;
binder_call(priv_app, hal_touchfeature_xiaomi_default)

allow platform_app vendor_sysfs_touch:file rw_file_perms;
allow priv_app vendor_sysfs_touch:file rw_file_perms;

typeattribute vendor_sysfs_touch mlstrustedobject;

# Thermal scenario per app (thermal_message/sconfig, labeled in the device tree)
allow { platform_app priv_app } sysfs_thermal:dir search;
allow { platform_app priv_app } vendor_sysfs_thermal_sconfig:file rw_file_perms;
