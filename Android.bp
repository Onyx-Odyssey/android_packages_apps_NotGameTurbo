android_app {
    name: "NotGameTurbo",
    certificate: "platform",
    defaults: ["SettingsLibDefaults"],
    srcs: ["src/**/*.kt"],
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
    required: ["privapp-permissions-notgameturbo.xml"],
    static_libs: [
        "SettingsLibSliderPreference",
        "androidx.appcompat_appcompat",
        "androidx.core_core",
        "androidx.preference_preference",
        "org.lineageos.settings.resources",
        "//device/xiaomi/onyx:vendor.xiaomi.hw.touchfeature-V1-java",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-notgameturbo.xml",
    src: "privapp-permissions-notgameturbo.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
